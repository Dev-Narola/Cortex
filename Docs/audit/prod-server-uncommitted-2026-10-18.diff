-        session.commit()
-
-        # ------------------------------------------------------------------
-        # 3. Mark PARSING
-        # ------------------------------------------------------------------
-        doc_repo.update_status(doc_id, tenant_id=ten_id, status=DocumentStatus.PARSING)
-        session.commit()
