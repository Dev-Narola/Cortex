  },
  "dependencies": {
    "@cortex/config": "workspace:*",
    "openapi-fetch": "0.13.4"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.9.0",
    "openapi-typescript": "7.4.4",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
