{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "extends": ["biome.json"],
  "files": {
    "ignore": [".next", "node_modules", "playwright-report", "test-results"]
  },
  "linter": {
    "rules": {
      "recommended": true,
      "a11y": { "recommended": true },
      "suspicious": { "noExplicitAny": "warn" }
    }
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  }
}
