APP_NAME="Cortex"
APP_VERSION="0.1.0"
APP_DESCRIPTION="Multi-tenant AI Knowledge and Agent Platform"
DEBUG=True
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000
WORKERS=1
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/app"
REDIS_URL="redis://localhost:6379/0"
SECRET_KEY="change-me-in-development"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_BCRYPT_ROUNDS=12
API_KEY_BCRYPT_ROUNDS=10

# --- Object storage (S3 / S3-compatible, e.g. MinIO) ---
# In production, leave S3_ENDPOINT unset and provide a real
# S3_REGION + S3_BUCKET + AWS-style credentials. The S3Storage
# adapter routes everything through the same `ObjectStorage`
# interface either way, so app code does not need to change
# between local dev and production.
#
# For local development with MinIO (the project's recommended
# local S3-compatible store), set S3_ENDPOINT to the MinIO API
# URL, and reuse the MinIO access/secret keys for
# S3_ACCESS_KEY / S3_SECRET_KEY. The matching docker-compose
# service brings MinIO up at http://localhost:9000 with a
# console at http://localhost:9001.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="cortex-documents-dev-2026"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="miniopassword"
